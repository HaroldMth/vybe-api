# --- metadata / feed (all optional, all free) ---
# Last.fm key (https://www.last.fm/api/account/create) turns on "similar tracks" + tag charts. Everything works without it.
# LASTFM_KEY=
# Genre rows to spotlight on home (matched against Deezer genre names)
HOME_SPOTLIGHT=africa,afro
# How far back "new releases" looks
NEW_RELEASE_DAYS=120
# Wikipedia/MusicBrainz ask for a contact in the User-Agent
MUSICBRAINZ_USER_AGENT=VYBE/1.0 (mailto:you@example.com)
# AUDIODB_KEY=2
# Rate limits per IP per minute
# RATE_LIMIT_PER_MIN=120
# RATE_LIMIT_HEAVY_PER_MIN=20
